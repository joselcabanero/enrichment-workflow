# Copy to .env and fill in the keys you have. All are optional:
# the module always runs the keyless Wikidata/Wikipedia source and simply
# skips any source whose key is absent.

# Apollo.io API key (Settings -> Integrations -> API). Free plan = 75 credits/mo;
# organization enrichment consumes credits.
APOLLO_API_KEY=

# OpenCorporates API token (https://opencorporates.com/api_accounts/new).
# Every request requires a token; a free token is available for open-data use.
OPENCORPORATES_API_TOKEN=

# Dealroom API key (https://dealroom.co/api-access). No free tier — full API
# access requires a paid subscription; the adapter is skipped without a key.
DEALROOM_API_KEY=

# PatentsView / USPTO Search API key (request free at https://patentsview.org/apis).
# The current Search API (search.patentsview.org) requires a key; skipped without one.
PATENTSVIEW_API_KEY=

# EPO Open Patent Services (free): register an app at https://developers.epo.org
# to get a consumer key + secret. Covers EP / WO / worldwide filings (fills the
# gap PatentsView leaves for European startups). Both required; skipped otherwise.
EPO_OPS_KEY=
EPO_OPS_SECRET=

# Anthropic API key for the web-research source (founders, funding rounds,
# investors via Claude + web search) and taxonomy classification. Both are
# skipped without a key.
# RESEARCH_MODEL   — web research model (default claude-haiku-4-5, cheap).
# CLASSIFY_MODEL   — taxonomy classification model (default claude-sonnet-5;
#                    judging a ~400-term ontology against sparse evidence is
#                    worth the stronger model).
ANTHROPIC_API_KEY=
# RESEARCH_MODEL=claude-haiku-4-5
# CLASSIFY_MODEL=claude-sonnet-5
# CLASSIFY_VOTES — self-consistency votes per classification (1-5, default 5).
#                  Majority voting stabilizes borderline assignments across runs;
#                  1 = single call (cheapest).
# CLASSIFY_VOTES=5
# Cost notes: the taxonomy block is prompt-cached — votes after the first, and
# subsequent companies within ~5 minutes, bill its tokens at ~0.1x. Voting
# early-stops at 3 when unanimous. Set CLASSIFY_DEBUG=1 to log per-vote token
# usage (cache writes/reads) to stderr.
# CLASSIFY_DEBUG=1
